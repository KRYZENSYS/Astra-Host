# ==============================================================================
# BotHost Stage 1 Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
APP_URL=http://localhost

# PostgreSQL 16 Settings
POSTGRES_USER=bothost_user
POSTGRES_PASSWORD=bothost_secure_password_change_me_2026
POSTGRES_DB=bothost_db
DATABASE_URL=postgresql+asyncpg://bothost_user:bothost_secure_password_change_me_2026@postgres:5432/bothost_db

# Cryptography & Secrets (Generate a 32-byte urlsafe base64 key)
# Command: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=bQpE3u9vW9wW9_eXampleFernetKey32BytesLength=

# JWT Authentication
# Command: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_random_string_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Docker Host Integration
DOCKER_SOCKET_PATH=/var/run/docker.sock
BOT_STORAGE_DIR=/var/lib/bothost/bots
MAX_BOTS_PER_USER=1
