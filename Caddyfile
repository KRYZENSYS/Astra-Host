# Caddy reverse proxy for BotHost (Automatic HTTPS or local HTTP)
{
    admin off
}

:80 {
    # Encode responses with gzip and zstd
    encode gzip zstd

    # Max upload limit: 25 MB for bot zip archives
    request_body {
        max_size 25MB
    }

    # API endpoints directed to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Disable buffering for Server-Sent Events (SSE) live log streaming
            transport http {
                response_header_timeout 3600s
            }
        }
    }

    # Frontend single page application
    handle {
        reverse_proxy frontend:3000
    }
}
